{
  "files.insertFinalNewline": true,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "editor.formatOnSave": true,
  "terminal.integrated.enableMultiLinePasteWarning": false,
  "explorer.compactFolders": false,
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "workbench.startupEditor": "none",
  "docker.extension.enableComposeLanguageServer": false,
  "workbench.colorTheme": "Dark Modern",
  "claudeCode.preferredLocation": "panel",
  "terminal.integrated.stickyScroll.enabled": false,
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide",
  },
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": ["nixfmt"],
      },
      // dotfiles の flake から nixpkgs / nix-darwin / home-manager の定義を読み込み、補完に使う
      "nixpkgs": {
        "expr": "import (builtins.getFlake \"/Users/raita/Repository/dotfiles\").inputs.nixpkgs { }",
      },
      "options": {
        "nix-darwin": {
          "expr": "(builtins.getFlake \"/Users/raita/Repository/dotfiles\").darwinConfigurations.raita-mba.options",
        },
        "home-manager": {
          "expr": "(builtins.getFlake \"/Users/raita/Repository/dotfiles\").darwinConfigurations.raita-mba.options.home-manager.users.type.getSubOptions []",
        },
      },
    },
  },
}
