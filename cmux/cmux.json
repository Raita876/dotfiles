{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  "actions": {
    "home-claude": {
      "type": "workspace",
      "title": "Home + Claude",
      // cmux 0.65.1 の不具合回避: ⌘N が ui.newWorkspace.action を無視するため、⌘N をこのアクションに直接割り当てる。
      // 組み込みの newTab の解除とあわせて、upstream で修正されたら外す
      "shortcut": "cmd+n",
      "restart": "new",
      "workspace": {
        // name は固定しない。固定すると手動リネーム扱いになり、自動命名が効かなくなる
        "cwd": "~",
        "layout": {
          "pane": {
            "surfaces": [
              { "type": "terminal", "name": "Claude", "command": "claude", "focus": true }
            ]
          }
        }
      }
    }
  },
  "ui": {
    "newWorkspace": {
      "action": "home-claude"
    }
  },

  "automation": {
    "workspaceAutoNaming": true,
    "autoNamingAgent": "auto",
    "claudeCodeIntegration": true
  },

  "shortcuts": {
    "bindings": {
      // ⌘[ ⌘] ⌘^[ ⌘^] (ワークスペースの切替・並び替え) と ⌥⌘[ ⌥⌘] (ブラウザの戻る・進む) はここに書かない。
      // JIS キーボードではファイル経由の "[" "]" 指定が二重に一致して誤動作するため (upstream issue #3061)、
      // UserDefaults の com.cmuxterm.app に直接登録している (scripts/cmux/cmux-shortcuts.sh)
      "closeWorkspace": "cmd+ctrl+n",
      "splitDown": "cmd+ctrl+d",
      "focusLeft": "cmd+←",
      "focusRight": "cmd+→",
      "focusUp": "cmd+↑",
      "focusDown": "cmd+↓",
      "prevSurface": "cmd+,",
      "nextSurface": "cmd+.",
      "moveSurfaceLeft": "cmd+ctrl+,",
      "moveSurfaceRight": "cmd+ctrl+.",
      "renameWorkspace": "cmd+r",
      "renameTab": "cmd+shift+r",
      "openSettings": "cmd+shift+,",

      // 上の割り当てと衝突する既定のショートカットを解除する
      "newTab": null,
      "toggleFocusedWorkspaceGroupCollapsed": null,
      "newPaneAutoLayout": null,
      "focusHistoryBack": null,
      "focusHistoryForward": null,
      "reloadConfiguration": null,
      "fileExplorerOpenSelectionFinderAlias": null,
      "simulatorRotateLeft": null,
      "simulatorRotateRight": null
    }
  }
}
