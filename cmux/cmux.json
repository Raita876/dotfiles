{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  "actions": {
    "home-agent": {
      "type": "workspace",
      "title": "Home + Agent",
      // cmux の不具合回避: ⌘N が ui.newWorkspace.action を無視するため、⌘N をこのアクションに直接割り当てる。upstream では修正済みとされるが 0.65.2 でも直っていない (manaflow-ai/cmux#20268)
      "shortcut": "cmd+n",
      "restart": "new",
      "workspace": {
        // name は固定しない。固定すると手動リネーム扱いになり、自動命名が効かなくなる
        "cwd": "~",
        "layout": {
          "pane": {
            "surfaces": [
              { "type": "terminal", "name": "Agent", "command": "cmux-agent", "focus": true }
            ]
          }
        }
      }
    }
  },
  "ui": {
    "newWorkspace": {
      "action": "home-agent"
    }
  },

  "automation": {
    "workspaceAutoNaming": true,
    "autoNamingAgent": "auto",
    "claudeCodeIntegration": true
  },

  // 内蔵ブラウザは使わない。リンクはすべて既定のブラウザで開く
  "browser": {
    "openTerminalLinksInCmuxBrowser": false,
    "interceptTerminalOpenCommandInCmuxBrowser": false
  },
  "sidebar": {
    "openPullRequestLinksInCmuxBrowser": false,
    "openPortLinksInCmuxBrowser": false
  },

  "shortcuts": {
    "bindings": {
      "prevSidebarTab": "cmd+o",
      "nextSidebarTab": "cmd+l",
      "moveWorkspaceUp": "cmd+ctrl+o",
      "moveWorkspaceDown": "cmd+ctrl+l",
      "closeWorkspace": "cmd+ctrl+n",
      "focusLeft": "cmd+←",
      "focusRight": "cmd+→",
      "focusUp": "cmd+↑",
      "focusDown": "cmd+↓",
      "prevSurface": "cmd+,",
      "nextSurface": "cmd+.",
      "moveSurfaceLeft": "cmd+ctrl+,",
      "moveSurfaceRight": "cmd+ctrl+.",
      "renameWorkspace": "cmd+r",
      "renameTab": "cmd+shift+r",
      "openSettings": "cmd+shift+,",

      "newTab": null,
      "openFolder": null,
      "focusBrowserAddressBar": null,
      "openBrowser": null,
      "splitBrowserRight": null,
      "splitBrowserDown": null,
      "newBrowserWorkspace": null,
      "canvasOverview": null,
      "toggleFocusedWorkspaceGroupCollapsed": null,
      "newPaneAutoLayout": null,
      "focusHistoryBack": null,
      "focusHistoryForward": null,
      "reloadConfiguration": null,
      "fileExplorerOpenSelectionFinderAlias": null,
      "simulatorRotateLeft": null,
      "simulatorRotateRight": null
    }
  }
}
