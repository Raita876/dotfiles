{
  "version": 1,
  "rules": [
    {
      "id": "new-workspace-launch-claude",
      "when": { "event": "surface.created" },
      "where": {
        "surface.kind": "terminal",
        "origin": "workspace_initial"
      },
      "rate_limit": { "interval_seconds": 1, "maximum": 5 },
      "then": [
        {
          "action": "run",
          "command": "/bin/bash \"$HOME/.config/cmux/launch-claude-on-new-workspace.sh\"",
          "timeout_seconds": 30
        }
      ]
    }
  ]
}
